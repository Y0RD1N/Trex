{
  "bundle": {
    "targets": [
      "rpm"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "gtk3",
          "webkit2gtk4.1",
          "libxdo",
          "openssl-libs"
        ],
        "recommends": [
          "gnome-keyring"
        ],
        "files": {
          "/usr/bin/trex-agent": "installer/payload/trex-agent"
        },
        "compression": {
          "type": "zstd",
          "level": 9
        }
      }
    }
  }
}
