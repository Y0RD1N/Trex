{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "trex",
  "version": "0.2.0",
  "identifier": "com.trex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build:desktop",
    "beforeBundleCommand": "npm run build:components",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "trex",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
