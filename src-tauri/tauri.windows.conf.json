{
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "installer/payload/trex-agent.exe": "trex-agent.payload",
      "installer/payload/browser/trex-browser.exe": "trex-browser.payload",
      "installer/payload/browser/trex-browser-runtime/": "trex-browser-runtime.payload/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerHooks": "installer/trex-cli.nsh"
      }
    }
  }
}
