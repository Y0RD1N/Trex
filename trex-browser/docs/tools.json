{
  "tools": [
    {
      "name": "browser_batch",
      "description": "Run 1..16 ordered browser steps; all are validated before any action. Stops at the first error or cancellation; completed steps are never rolled back or replayed. Returns per-step results. Use selectors or explicit tabId (get unknown refs in a separate call). No nested batches, ownership changes or captures.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "enum": [
                    "browser_navigate",
                    "browser_navigate_back",
                    "browser_reload",
                    "browser_tabs",
                    "browser_frames",
                    "browser_snapshot",
                    "browser_click",
                    "browser_hover",
                    "browser_drag",
                    "browser_mouse",
                    "browser_press_key",
                    "browser_type",
                    "browser_fill_form",
                    "browser_select_option",
                    "browser_evaluate",
                    "browser_resize",
                    "browser_emulate",
                    "browser_console_messages",
                    "browser_network_requests",
                    "browser_network_body",
                    "browser_take_screenshot",
                    "browser_wait_for"
                  ]
                },
                "arguments": {
                  "type": "object"
                }
              },
              "required": [
                "tool",
                "arguments"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
